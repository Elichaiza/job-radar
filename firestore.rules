rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user reads and writes only their own marks.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Company-search requests: any signed-in user may add one; the collector
    // (which has no credentials) reads them.
    match /requests/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.by == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.keys().hasOnly(['name', 'url', 'ats', 'slug', 'by']);
    }
  }
}
